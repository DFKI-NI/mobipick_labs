<?xml version="1.0"?>
<launch>
  <!-- Videos of the experiment camera that only contain the moments the robot moves; every frame shows the video id
       (also the file name prefix) and what was run: the command and/or the goal sent to the LLM with its model, as
       lime text in a black strip on top of the camera picture (the frames grow in height by that strip). Gripper / robot camera topics are refused. -->
  <arg name="image_topics" default="/experiment_camera/image_raw" />
  <arg name="output_dir" default="/data/experiment_recordings" />
  <arg name="name" default="" />
  <arg name="title" default="" />  <!-- a short readable title of the video, e.g. baseline-run-1-drill-pick-sim: goes into the file name after the id (a-z, 0-9 and - only, at most 40 characters); empty: the file name carries the topic name -->
  <arg name="fps" default="10.0" />
  <arg name="command" default="" />  <!-- the command that runs the experiment, shown in the text strip of every frame -->
  <!-- the goal topic of the GPT demo (GUI speech input, agent_experiment.py): the last goal sent to the LLM is shown
       with the model profile (the agent's model_label_param parameter); "" with an empty command refuses to start -->
  <arg name="command_topic" default="/recognized_speech" />
  <arg name="model_label_param" default="experiment_model_label" />
  <arg name="forbidden_topic_pattern" default="gripper|eef|wrist|hand_cam|arm_cam" />
  <arg name="auto_pause" default="true" />
  <arg name="motion_hold_s" default="1.5" />
  <arg name="start_paused" default="false" />
  <arg name="overlay" default="true" />
  <arg name="joint_pattern" default="ur5" />  <!-- the simulated gripper finger reports ~0.18 rad/s at rest -->
  <!-- fragmented VP8 MP4 that stays playable when the recorder is killed (false: OpenCV's mp4v, unplayable then) -->
  <arg name="crash_safe" default="true" />
  <arg name="bitrate_kbps" default="2000" />

  <node pkg="experiment_camera_recorder" type="video_recorder.py" name="experiment_video_recorder" output="screen">
    <param name="image_topics" value="$(arg image_topics)" />
    <param name="output_dir" value="$(arg output_dir)" />
    <param name="name" value="$(arg name)" />
    <param name="title" type="str" value="$(arg title)" />
    <param name="fps" value="$(arg fps)" />
    <param name="command" type="str" value="$(arg command)" />
    <param name="command_topic" value="$(arg command_topic)" />
    <param name="model_label_param" value="$(arg model_label_param)" />
    <param name="forbidden_topic_pattern" value="$(arg forbidden_topic_pattern)" />
    <param name="auto_pause" value="$(arg auto_pause)" />
    <param name="motion_hold_s" value="$(arg motion_hold_s)" />
    <param name="start_paused" value="$(arg start_paused)" />
    <param name="overlay" value="$(arg overlay)" />
    <param name="joint_pattern" value="$(arg joint_pattern)" />
    <param name="crash_safe" value="$(arg crash_safe)" />
    <param name="bitrate_kbps" value="$(arg bitrate_kbps)" />
  </node>
</launch>
