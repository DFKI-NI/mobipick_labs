<?xml version="1.0"?>
<!-- One camera pose per world. pose_tuner.py rewrites the pose of the world it tunes when its OK button is clicked. -->
<launch>
  <arg name="world_config" default="moelk_tables" />
  <arg name="record" default="false" />
  <arg name="record_frequency" default="0.2" />
  <arg name="output_dir" default="" />
  <!-- another scene copy of a multi-robot sim: its own camera name, the same pose shifted by the copy offset -->
  <arg name="camera_name" default="experiment_camera" />
  <arg name="offset_x" default="0.0" />

  <include if="$(eval world_config == 'moelk_tables')" file="$(find experiment_camera_recorder)/launch/camera.launch">
    <arg name="x" value="12.070" />
    <arg name="y" value="4.720" />
    <arg name="z" value="3.760" />
    <arg name="roll" value="-0.1940" />
    <arg name="pitch" value="0.9080" />
    <arg name="yaw" value="-1.7740" />
    <arg name="record" value="$(arg record)" />
    <arg name="record_frequency" value="$(arg record_frequency)" />
    <arg name="output_dir" value="$(arg output_dir)" />
    <arg name="camera_name" value="$(arg camera_name)" />
    <arg name="offset_x" value="$(arg offset_x)" />
  </include>

  <include if="$(eval world_config == 'cic_tables')" file="$(find experiment_camera_recorder)/launch/camera.launch">
    <arg name="x" value="20.740" />
    <arg name="y" value="11.440" />
    <arg name="z" value="3.300" />
    <arg name="roll" value="0.0000" />
    <arg name="pitch" value="0.6728" />
    <arg name="yaw" value="1.6340" />
    <arg name="record" value="$(arg record)" />
    <arg name="record_frequency" value="$(arg record_frequency)" />
    <arg name="output_dir" value="$(arg output_dir)" />
    <arg name="camera_name" value="$(arg camera_name)" />
    <arg name="offset_x" value="$(arg offset_x)" />
  </include>

  <!-- worlds without a tuned pose get the camera.launch default pose -->
  <include unless="$(eval world_config in ['moelk_tables', 'cic_tables'])" file="$(find experiment_camera_recorder)/launch/camera.launch">
    <arg name="record" value="$(arg record)" />
    <arg name="record_frequency" value="$(arg record_frequency)" />
    <arg name="output_dir" value="$(arg output_dir)" />
    <arg name="camera_name" value="$(arg camera_name)" />
    <arg name="offset_x" value="$(arg offset_x)" />
  </include>
</launch>
