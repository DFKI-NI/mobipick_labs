repositories:
  dot_graph_visualization:
    type: git
    url: https://github.com/DFKI-NI/dot_graph_visualization.git
    version: main
  espeak_ros:
    type: git
    url: https://github.com/socrob/espeak_ros.git
    version: master
  gazebo_jointed_chain:
    # the generic Gazebo plugin behind the simulated cable carrier chain (mobipick_cable_entanglement)
    type: git
    url: https://github.com/oscar-lima/gazebo_jointed_chain.git
    version: main
  grasplan:
    type: git
    url: https://github.com/DFKI-NI/grasplan.git
    version: noetic
  mir_robot:
    # the fork branch path-follower-critic: the DWB path follower
    # critic and SBPL settings the tables demo navigation is tested with (the apt ros-noetic-mir-navigation gets
    # stuck often), plus the map_ns, map_frame and global_frame_id args of the multi-robot sim
    type: git
    url: https://github.com/oscar-lima/mir_robot.git
    version: path-follower-critic
  mobipick:
    type: git
    url: https://github.com/DFKI-NI/mobipick.git
    version: noetic
  mobipick_api:
    type: git
    url: https://github.com/DFKI-NI/mobipick_api.git
    version: noetic
  object_pose_msgs:
    type: git
    url: https://github.com/DFKI-NI/object_pose_msgs.git
    version: main
  pbr_objects:
    type: git
    url: https://github.com/DFKI-NI/pbr_objects.git
    version: master
  pose_selector:
    type: git
    url: https://github.com/DFKI-NI/pose_selector.git
    version: noetic
  robot_api:
    # main, not releases: the last release (v1.5.2, 2022) still names the FtObserver feedback actualForce while
    # mobipick_pick_n_place has actual_force since 2025; the md5 mismatch keeps the tables demo from connecting to
    # ft_observer. main builds on noetic (dual ROS 1/ROS 2 package) and carries the rename.
    type: git
    url: https://github.com/DFKI-NI/robot_api.git
    version: main
  symbolic_fact_generation:
    type: git
    url: https://github.com/DFKI-NI/symbolic_fact_generation.git
    version: main
