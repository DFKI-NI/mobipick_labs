<?xml version="1.0"?>
<launch>
  <arg name="world_config" default="moelk_tables" doc="objects arrangement, options: moelk_tables, cic_tables" />
  <arg name="anygrasp_handles_execution" default="false" />
  <arg name="use_ur_polished_kinematics" default="false" doc="select the calibrated analytic UR5 IK plugin instead of TRAC-IK for MoveIt" />
  <arg name="use_ur_polished_kinematics_robot2" default="$(arg use_ur_polished_kinematics)" doc="IK solver of robot 2 (num_robots >= 2), for solver races; default the same as use_ur_polished_kinematics" />
  <arg name="use_ur_polished_kinematics_robot3" default="$(arg use_ur_polished_kinematics)" doc="IK solver of robot 3 (num_robots 3), for solver races; default the same as use_ur_polished_kinematics" />
  <arg name="use_mtc" default="false" doc="true: plan and execute grasplan pick, place and insert with MoveIt Task Constructor instead of the MoveIt pick n place pipeline (move_group pickup/place actions)" />
  <arg name="mtc_lift_tolerate_touching_neighbours" default="false" doc="allow a just-attached object to clear only box neighbours already touching it during a straight-up MTC lift (careful flag, off in code)" />
  <arg name="mtc_cable_constraints" default="false" doc="old name of mtc_cable_plan_check, still accepted" />
  <arg name="mtc_cable_plan_check" default="$(arg mtc_cable_constraints)" doc="true (with use_mtc): check every planned MTC joint path against the arm cable model (mobipick_cable_entanglement) and throw away a plan that would stretch the cable tube, then try the next one; the same switch also makes the free motions keep wrist_3 within a window around its least-wound angle, a planning constraint (the real robot's wrist_3 limits are tighter than that window, so there only the check acts)" />
  <arg name="pick_start_move_carrier_stops" default="false" doc="true (with use_mtc and the MTC cable guard): the open-set pick's start move from the grasp view to transport refuses a plan the cable chain replay predicts the monitor to stop, replans, then detours via the observation pose; refused there too, the pick stops without moving; careful feature flag, off in code" />
  <arg name="plan_pick_during_start_move" default="false" doc="true (with use_mtc): a closed-set pick plans and cable-checks its untangle arm poses up front, sends them as one motion and plans the pick with MTC while the arm moves; the plan is used only when the arm arrives where it starts, else it is planned again; careful feature flag, off in code" />
  <arg name="mtc_cable_path_shaping" default="false" doc="true (with use_mtc and mtc_cable_plan_check): the arm cable model shapes the path before planning: the IK branch with the most cable slack, model-chosen joint waypoints and a wrist corridor; the cable guard stays the final check; careful feature flag, off in code" />
  <arg name="mtc_cable_support_margin" default="false" doc="true (with mtc_cable_plan_check): with the support wrist anchor (the sim) the MTC cable guard plans with a -0.07 geometric stretch margin instead of -0.115, so fewer arm paths are rejected as entangling; careful feature flag, off in code" />
  <arg name="mtc_cable_replay_live_state" default="false" doc="true (with mtc_cable_plan_check): the cable guard's replay of a planned path through the carrier link chain goes on from the cable monitor's live chain (its chain_state service) and the path must also pass a replay from a fresh chain (both must pass), so the guard sees what the motions before the path did; the fresh chain is also what is used where the monitor resets its chain at every trajectory start; careful feature flag, off in code" />
  <arg name="mtc_cable_replay_detour" default="false" doc="true (with mtc_cable_plan_check): when the cable guard refused a closed-set pick by its chain replay alone, move the arm to untangle_cable_guide_2_right as a separate motion and plan the pick once more from there; no detour while the named-move guard only logs (the real robot default); careful feature flag, off in code" />
  <arg name="open_set_box_padding" default="0.0" doc="metres taken off every side of the open-set detector box of the target before it goes into the planning scene and the grasp geometry (the detector pads every side); 0.0 keeps the box as detected; careful feature flag, off in code" />
  <arg name="open_set_align_jaw_to_box" default="false" doc="a near-vertical open-set grasp whose jaw is well off the axes of the target box (across its diagonal) gets a copy turned about its approach onto the nearest box axis whose side fits the gripper, tried first; safe feature flag, off in code" />
  <arg name="open_set_align_jaw_narrowest_side" default="false" doc="with open_set_align_jaw_to_box: the first turned copy closes across the narrowest side of the target box that fits the gripper, also for a grasp that already closes across a wider side; the nearest-side copy comes second, then the original; careful feature flag, off in code" />
  <arg name="skip_pre_open_when_open" default="false" doc="true: the pick skips its gripper pre-open when the finger joint already reads open (within 15 mm of the configured open width), about 0.9 s per pick; no reading or a partly closed gripper opens as before; safe feature flag, off in code" />
  <arg name="grasp_standing_tilt_band" default="false" doc="true: for a standing elongated object taller than 5 cm the pick drops the open-set grasps whose approach is 25 to 65 deg off vertical (they pinch the rim and the object tips at the place); the unfiltered grasps stay when none is left; careful feature flag, off in code" />
  <arg name="grasp_regrasp_on_overclose" default="false" doc="true: after the close the finger angle is compared with the one flat pads show on the perceived object width; closed 20 mm or more past it (a fingertip pinch) the gripper opens, goes deeper by the excess (at most 3 cm, never into the table, never on a backed-off grasp) and closes again before the lift; careful feature flag, off in code" />
  <arg name="open_set_strip_reported_padding" default="false" doc="take off the padding the open-set detection reports for its box (box_padding of the detected object) instead of open_set_box_padding, which stays the fallback for a detection without it; careful flag, off by default" />
  <arg name="object_spawn" default="fixed" doc="sim only: fixed = the objects at the fixed poses of the world launch (default); random = the open-set objects (mobipick_open_set_objects) are moved once, after the world is up, to seeded random spots in the reachable front band of tables 1-3 (clear of each other and of the fixed objects). The closed-set (DOPE) objects stay at their fixed poses, so DOPE and the planning scene stay valid. A launch choice, not a feature flag; only the cic_tables world has the table list and sizes for it, other worlds ignore it" />
  <arg name="object_seed" default="0" doc="sim only: seed of object_spawn:=random; the same seed gives the same scene" />
  <arg name="insert_cable_gate" default="false" doc="true: rank insert poses by predicted cable stretch and offer likely safe ones first; safe feature flag, off in code" />
  <arg name="cable_detour_mode" default="hack" doc="hack: the closed-set objects visit the fixed untangle poses before a pick, place and insert, as always; cable_aware: no untangle pose at all (also no cable replay detour), the MTC cable guard is the protection and a refused motion fails with a clear text; careful flag, hack in the code" />
  <arg name="place_same_orientation_as_picked" default="true" doc="false: small objects (e.g. balls, fruit) are inserted with the gripper pointing straight down and the wrist turned as little as possible, instead of in the orientation they were grasped in (avoids winding up the arm cable)" />
  <arg name="insert_orientation" default="free_yaw" doc="free_yaw (default: keep the picked roll and pitch, choose the yaw for the least wrist rotation), as_picked or gripper_down; empty: place_same_orientation_as_picked decides (true: as_picked, false: gripper_down)" />
  <arg name="cable_monitor" default="false" doc="true: start the observe-only arm cable monitor (mobipick_cable_entanglement): in the sim it presses the simulated UR protective stop when its model predicts an entangled cable; on the real robot it never commands anything and logs every tick and every protective stop for calibration" />
  <arg name="geometric_check" default="true" doc="the carrier link chain alone decides when false; monitor and MTC guard replay (cable_entanglement_monitor.launch)" />
  <arg name="release_after_rest_s" default="0.0" doc="careful flag, off in code: > 0 = the carrier link chain starts afresh when the arm moves again after resting that many seconds" />
  <arg name="release_during_rest" default="false" doc="careful flag, off in code: with release_after_rest_s > 0 the chain starts afresh once the arm has rested that long" />
  <arg name="untangle_with_chain" default="false" doc="safe flag, off in code: the sim untangle service plans from the carried carrier link chain and keeps it through the release" />
  <arg name="reset_at_trajectory_start" default="false" doc="careful flag, off in code: the chain starts afresh when an executed trajectory starts" />
  <arg name="reset_cache_mrad" default="0.0" doc="careful flag, off in code: > 0 = start-pose cache of the settled chain, rounding step in mrad" />
  <arg name="cable_carrier_sim" default="false" doc="sim only prototype, off by default: the arm cable carrier of the wrist span as a jointed chain in Gazebo (gazebo_jointed_chain plugin, PLACEHOLDER stiffness until the real carrier is measured), colliding only with the cable model's shapes; it logs strain and clamp force events and never presses the protective stop; slows the sim about 27 %" />

  <arg name="num_robots" default="1" doc="2 or 3 = that many identical copies of the world_config scene side by side in one Gazebo, copy_gap apart, robot 1 (mobipick) in the first as with 1, robot k (mobipickK, map frame mobipickK/map) in copy k, for parallel experiments. Sim only; needs mobipick_gazebo/launch/worlds/WORLD_CONFIG_xN_spawn_sim_objects.launch (moelk_tables so far)" />
  <arg name="scene_size_x" default="15.9" doc="x extent of one scene copy, the bounding box of the moelk building with its tables and objects [m]; same default as mobipick_gazebo's moelk_tables_x2_spawn_sim_objects.launch" />
  <arg name="copy_gap" default="1.0" doc="gap between the bounding boxes of neighbouring scene copies [m]" />
  <arg name="copy_offset_x" value="$(eval float(arg('scene_size_x')) + float(arg('copy_gap')))" />
  <arg name="copy_offset_x_3" value="$(eval 2 * float(arg('copy_offset_x')))" />

  <!-- controls the simulation speed -->
  <arg name="physics_profile" default="fast" doc="options: slow, fast" />
  <arg name="grasp_fix" default="true" doc="Attach grasped objects with the gazebo_grasp_fix plugin instead of relying on friction (legacy hack; on by default in this demo, the launch files below it default to off)" />
  <arg name="joint_limits_parameters_file" default="$(find mobipick_description)/config/joint_limits.yaml" doc="ur5 joint limits yaml; mobipick_description/config/joint_limits_no_cable_guide.yaml drops the wrist_1/wrist_3 limits that only protect the real arm cable (the sim has none)" />

  <!-- if true, gzclient is started -->
  <arg name="gui" default="true" />

  <!-- Transparent overview camera and sparse experiment image recorder. -->
  <arg name="robot_colours" default="false" doc="sim only, a look, not a feature flag: true paints each robot's body covers in its colour by order (robot 1 blue, 2 orange, 3 green, 4 purple; mobipick_description/config/robot_colours.yaml) and draws a stripe of that colour high along the walls of its copy of the world, above what the cameras and lasers see; the floor stays. Only with num_robots 2 or more: a single robot has nobody to be told apart from and keeps the plain look" />
  <arg name="experiment_camera" default="true" />
  <arg name="experiment_camera_copies" default="$(eval int(num_robots) > 1)" doc="with num_robots 2 or 3 and experiment_camera: one more overview camera per scene copy, /experiment_cameraK/image_raw for robot K at the pose of the first shifted by the copy offset, so each robot can get its own overview video" />
  <arg name="start_ground_truth_viz" default="true" doc="publish the Gazebo tables and objects (boxes + URDF meshes) on /sim_ground_truth/* for RViz; only reads Gazebo while someone subscribes" />
  <arg name="legacy_dope_object_publisher" default="false" doc="true: start the legacy gazebo_object_publisher (fake DOPE detections of table_1 and the power drill from Gazebo); only robot_api's PickUpObject macro reads them" />
  <arg name="record_experiment_images" default="false" />
  <arg name="experiment_image_frequency" default="0.2" />
  <arg name="experiment_image_output_dir" default="" />

  <!-- start Gazebo and spawn objects in the simulated world -->
  <include file="$(find mobipick_gazebo)/launch/worlds/$(arg world_config)_spawn_sim_objects.launch" if="$(eval int(num_robots) == 1)">
    <arg name="joint_limits_parameters_file" value="$(arg joint_limits_parameters_file)" />
    <arg name="physics_profile" value="$(arg physics_profile)" />
    <arg name="grasp_fix" value="$(arg grasp_fix)" />
    <arg name="gui" value="$(arg gui)" />
    <!-- one robot: no robot_colours, the robot and the walls keep the plain look -->
  </include>
  <include file="$(find mobipick_gazebo)/launch/worlds/$(arg world_config)_x$(arg num_robots)_spawn_sim_objects.launch" if="$(eval int(num_robots) > 1)">
    <arg name="joint_limits_parameters_file" value="$(arg joint_limits_parameters_file)" />
    <arg name="physics_profile" value="$(arg physics_profile)" />
    <arg name="grasp_fix" value="$(arg grasp_fix)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="scene_size_x" value="$(arg scene_size_x)" />
    <arg name="copy_gap" value="$(arg copy_gap)" />
    <arg name="robot_colours" value="$(arg robot_colours)" />
  </include>
  <!-- the Gazebo cable carrier of robot 1 (spawned once the robot's joint states arrive) -->
  <include if="$(arg cable_carrier_sim)" file="$(find mobipick_cable_entanglement)/launch/cable_carrier_sim.launch" />

  <!-- object_spawn:=random moves the open-set objects once the world has spawned everything (settle 8 s) -->
  <include file="$(find mobipick_open_set_objects)/launch/spawn_open_set_objects.launch" if="$(eval object_spawn == 'random' and world_config == 'cic_tables' and int(num_robots) == 1)">
    <arg name="world" value="$(arg world_config)" />
    <arg name="seed" value="$(arg object_seed)" />
    <arg name="front_depth" value="0.35" />
    <arg name="wait_settle" value="8.0" />
  </include>
  <!-- automatically unpause gazebo simulation after some time -->
  <node pkg="pbr_gazebo" type="gazebo_unpauser" name="gazebo_unpauser" output="screen" />

  <!-- ground truth for RViz (group "Ground truth (sim)") -->
  <include if="$(arg start_ground_truth_viz)" file="$(find sim_ground_truth_viz)/launch/sim_ground_truth_viz.launch" />

  <include if="$(arg experiment_camera)" file="$(find experiment_camera_recorder)/launch/configured_camera.launch">
    <arg name="world_config" value="$(arg world_config)" />
    <arg name="record" value="$(arg record_experiment_images)" />
    <arg name="record_frequency" value="$(arg experiment_image_frequency)" />
    <arg name="output_dir" value="$(arg experiment_image_output_dir)" />
  </include>
  <!-- the overview cameras of the other scene copies: one video per robot (video_recorder.launch topic_robots) -->
  <group if="$(eval experiment_camera and experiment_camera_copies and int(num_robots) > 1)">
    <include file="$(find experiment_camera_recorder)/launch/configured_camera.launch">
      <arg name="world_config" value="$(arg world_config)" />
      <arg name="camera_name" value="experiment_camera2" />
      <arg name="offset_x" value="$(arg copy_offset_x)" />
    </include>
    <include if="$(eval int(num_robots) >= 3)" file="$(find experiment_camera_recorder)/launch/configured_camera.launch">
      <arg name="world_config" value="$(arg world_config)" />
      <arg name="camera_name" value="experiment_camera3" />
      <arg name="offset_x" value="$(arg copy_offset_x_3)" />
    </include>
  </group>

  <!-- The legacy pick_n_place object publisher turned Gazebo link poses into permanent fake DOPE detections
       (/mobipick/dope/detected_objects, /mobipick/dope/markers: a "table (1.0)" box at table_1 and "power_drill (1.0)")
       before any perception. The tables demo perceives with the logical camera and the pose selector and nothing in it
       reads these topics (only robot_api's unused PickUpObject macro), so it is off; true brings it back for that macro. -->
  <node if="$(arg legacy_dope_object_publisher)" name="gazebo_object_publisher" pkg="mobipick_pick_n_place"
        type="gazebo_object_publisher" ns="mobipick" output="screen">
    <param name="tf_prefix"  value="mobipick" />
    <param name="robot_name" value="mobipick" />
  </node>

  <!-- ::::: The ROS stack of every robot: fake localization, navigation, MoveIt, camera marker, cable tube drawing and the
       tables demo bringup, the same include for each; robot 1 keeps its global names (pose selectors, map) ::::: -->
  <include file="$(find tables_demo_bringup)/launch/includes/robot_stack_sim.launch">
    <arg name="namespace" value="mobipick" />
    <arg name="map_frame" value="map" />
    <arg name="map_ns" value="" />
    <arg name="pose_selector_ns" value="" />
    <arg name="offset_x" value="0.0" />
    <arg name="world_config" value="$(arg world_config)" />
    <arg name="use_ur_polished_kinematics" value="$(arg use_ur_polished_kinematics)" />
    <arg name="anygrasp_handles_execution" value="$(arg anygrasp_handles_execution)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="pick_start_move_carrier_stops" value="$(arg pick_start_move_carrier_stops)" />
    <arg name="plan_pick_during_start_move" value="$(arg plan_pick_during_start_move)" />
    <arg name="mtc_cable_path_shaping" value="$(arg mtc_cable_path_shaping)" />
    <arg name="mtc_cable_support_margin" value="$(arg mtc_cable_support_margin)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="mtc_cable_replay_detour" value="$(arg mtc_cable_replay_detour)" />
    <arg name="open_set_box_padding" value="$(arg open_set_box_padding)" />
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="open_set_align_jaw_to_box" value="$(arg open_set_align_jaw_to_box)" />
    <arg name="open_set_align_jaw_narrowest_side" value="$(arg open_set_align_jaw_narrowest_side)" />
    <arg name="skip_pre_open_when_open" value="$(arg skip_pre_open_when_open)" />
    <arg name="grasp_standing_tilt_band" value="$(arg grasp_standing_tilt_band)" />
    <arg name="grasp_regrasp_on_overclose" value="$(arg grasp_regrasp_on_overclose)" />
    <arg name="open_set_strip_reported_padding" value="$(arg open_set_strip_reported_padding)" />
    <arg name="mtc_lift_tolerate_touching_neighbours" value="$(arg mtc_lift_tolerate_touching_neighbours)" />
    <arg name="insert_cable_gate" value="$(arg insert_cable_gate)" />
    <arg name="place_same_orientation_as_picked" value="$(arg place_same_orientation_as_picked)" />
    <arg name="insert_orientation" value="$(arg insert_orientation)" />
    <arg name="cable_monitor" value="$(arg cable_monitor)" />
    <arg name="geometric_check" value="$(arg geometric_check)" />
    <arg name="release_after_rest_s" value="$(arg release_after_rest_s)" />
    <arg name="release_during_rest" value="$(arg release_during_rest)" />
    <arg name="untangle_with_chain" value="$(arg untangle_with_chain)" />
    <arg name="reset_at_trajectory_start" value="$(arg reset_at_trajectory_start)" />
    <arg name="reset_cache_mrad" value="$(arg reset_cache_mrad)" />
  </include>
  <!-- robots 2 and 3 in their scene copies (spawned by WORLD_CONFIG_xN_spawn_sim_objects.launch above) -->
  <include file="$(find tables_demo_bringup)/launch/includes/robot_stack_sim.launch" if="$(eval int(num_robots) >= 2)">
    <arg name="namespace" value="mobipick2" />
    <arg name="map_frame" value="mobipick2/map" />
    <arg name="map_ns" value="/mobipick2" />
    <arg name="pose_selector_ns" value="mobipick2" />
    <arg name="offset_x" value="$(arg copy_offset_x)" />
    <arg name="world_config" value="$(arg world_config)" />
    <arg name="use_ur_polished_kinematics" value="$(arg use_ur_polished_kinematics_robot2)" />
    <arg name="anygrasp_handles_execution" value="$(arg anygrasp_handles_execution)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="pick_start_move_carrier_stops" value="$(arg pick_start_move_carrier_stops)" />
    <arg name="plan_pick_during_start_move" value="$(arg plan_pick_during_start_move)" />
    <arg name="mtc_cable_path_shaping" value="$(arg mtc_cable_path_shaping)" />
    <arg name="mtc_cable_support_margin" value="$(arg mtc_cable_support_margin)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="mtc_cable_replay_detour" value="$(arg mtc_cable_replay_detour)" />
    <arg name="open_set_box_padding" value="$(arg open_set_box_padding)" />
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="open_set_align_jaw_to_box" value="$(arg open_set_align_jaw_to_box)" />
    <arg name="open_set_align_jaw_narrowest_side" value="$(arg open_set_align_jaw_narrowest_side)" />
    <arg name="skip_pre_open_when_open" value="$(arg skip_pre_open_when_open)" />
    <arg name="grasp_standing_tilt_band" value="$(arg grasp_standing_tilt_band)" />
    <arg name="grasp_regrasp_on_overclose" value="$(arg grasp_regrasp_on_overclose)" />
    <arg name="open_set_strip_reported_padding" value="$(arg open_set_strip_reported_padding)" />
    <arg name="mtc_lift_tolerate_touching_neighbours" value="$(arg mtc_lift_tolerate_touching_neighbours)" />
    <arg name="insert_cable_gate" value="$(arg insert_cable_gate)" />
    <arg name="place_same_orientation_as_picked" value="$(arg place_same_orientation_as_picked)" />
    <arg name="insert_orientation" value="$(arg insert_orientation)" />
    <arg name="cable_monitor" value="$(arg cable_monitor)" />
    <arg name="geometric_check" value="$(arg geometric_check)" />
    <arg name="release_after_rest_s" value="$(arg release_after_rest_s)" />
    <arg name="release_during_rest" value="$(arg release_during_rest)" />
    <arg name="untangle_with_chain" value="$(arg untangle_with_chain)" />
    <arg name="reset_at_trajectory_start" value="$(arg reset_at_trajectory_start)" />
    <arg name="reset_cache_mrad" value="$(arg reset_cache_mrad)" />
  </include>
  <include file="$(find tables_demo_bringup)/launch/includes/robot_stack_sim.launch" if="$(eval int(num_robots) >= 3)">
    <arg name="namespace" value="mobipick3" />
    <arg name="map_frame" value="mobipick3/map" />
    <arg name="map_ns" value="/mobipick3" />
    <arg name="pose_selector_ns" value="mobipick3" />
    <arg name="offset_x" value="$(arg copy_offset_x_3)" />
    <arg name="world_config" value="$(arg world_config)" />
    <arg name="use_ur_polished_kinematics" value="$(arg use_ur_polished_kinematics_robot3)" />
    <arg name="anygrasp_handles_execution" value="$(arg anygrasp_handles_execution)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="pick_start_move_carrier_stops" value="$(arg pick_start_move_carrier_stops)" />
    <arg name="plan_pick_during_start_move" value="$(arg plan_pick_during_start_move)" />
    <arg name="mtc_cable_path_shaping" value="$(arg mtc_cable_path_shaping)" />
    <arg name="mtc_cable_support_margin" value="$(arg mtc_cable_support_margin)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="mtc_cable_replay_detour" value="$(arg mtc_cable_replay_detour)" />
    <arg name="open_set_box_padding" value="$(arg open_set_box_padding)" />
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="open_set_align_jaw_to_box" value="$(arg open_set_align_jaw_to_box)" />
    <arg name="open_set_align_jaw_narrowest_side" value="$(arg open_set_align_jaw_narrowest_side)" />
    <arg name="skip_pre_open_when_open" value="$(arg skip_pre_open_when_open)" />
    <arg name="grasp_standing_tilt_band" value="$(arg grasp_standing_tilt_band)" />
    <arg name="grasp_regrasp_on_overclose" value="$(arg grasp_regrasp_on_overclose)" />
    <arg name="open_set_strip_reported_padding" value="$(arg open_set_strip_reported_padding)" />
    <arg name="mtc_lift_tolerate_touching_neighbours" value="$(arg mtc_lift_tolerate_touching_neighbours)" />
    <arg name="insert_cable_gate" value="$(arg insert_cable_gate)" />
    <arg name="place_same_orientation_as_picked" value="$(arg place_same_orientation_as_picked)" />
    <arg name="insert_orientation" value="$(arg insert_orientation)" />
    <arg name="cable_monitor" value="$(arg cable_monitor)" />
    <arg name="geometric_check" value="$(arg geometric_check)" />
    <arg name="release_after_rest_s" value="$(arg release_after_rest_s)" />
    <arg name="release_during_rest" value="$(arg release_during_rest)" />
    <arg name="untangle_with_chain" value="$(arg untangle_with_chain)" />
    <arg name="reset_at_trajectory_start" value="$(arg reset_at_trajectory_start)" />
    <arg name="reset_cache_mrad" value="$(arg reset_cache_mrad)" />
  </include>
</launch>
