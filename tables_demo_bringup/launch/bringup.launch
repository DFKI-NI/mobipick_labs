<?xml version="1.0"?>
<launch>
  <arg name="simulation" default="false" />
  <arg name="world_config" default="moelk_tables" doc="objects arrangement, options: moelk_tables, cic_tables" />
  <arg name="objects_of_interest" default="[relay, screwdriver, multimeter, power_drill_with_grip, hot_glue_gun, klt, bleach, mustard, soup, meat]"/>
  <arg name="dope_converter_config" default="$(find pbr_objects)/config/class_ids.yaml" />
  <arg name="anygrasp_handles_execution" default="false" />
  <arg name="use_mtc" default="false" doc="true: plan and execute grasplan pick, place and insert with MoveIt Task Constructor instead of the MoveIt pick n place pipeline (move_group pickup/place actions)" />
  <arg name="mtc_lift_tolerate_touching_neighbours" default="false" doc="allow a just-attached object to clear only box neighbours already touching it during a straight-up MTC lift (#229; careful flag, off in code)" />
  <arg name="mtc_cable_constraints" default="false" doc="old name of mtc_cable_plan_check, still accepted" />
  <arg name="mtc_cable_plan_check" default="$(arg mtc_cable_constraints)" doc="true (with use_mtc): check every planned MTC joint path against the arm cable model (mobipick_cable_entanglement) and throw away a plan that would stretch the cable tube, then try the next one; the same switch also makes the free motions keep wrist_3 within a window around its least-wound angle, a planning constraint (the real robot's wrist_3 limits are tighter than that window, so there only the check acts)" />
  <arg name="mtc_cable_replay_live_state" default="false" doc="true (with mtc_cable_plan_check): the cable guard's replay of a planned path through the carrier link chain goes on from the cable monitor's live chain (its chain_state service) instead of a fresh chain, so it sees what the motions before the path did; a fresh chain where the monitor resets its chain at every trajectory start; safe feature flag, off in code" />
  <arg name="mtc_cable_replay_detour" default="false" doc="true (with mtc_cable_plan_check): when the cable guard refused a closed-set pick by its chain replay alone, move the arm to untangle_cable_guide_2_right as a separate motion and plan the pick once more from there; no detour while the named-move guard only logs (the real robot default); careful feature flag, off in code" />
  <arg name="open_set_box_padding" default="0.0" doc="metres taken off every side of the open-set detector box of the target before it goes into the planning scene and the grasp geometry (the detector pads every side); 0.0 keeps the box as detected; careful feature flag, off in code" />
  <arg name="open_set_align_jaw_to_box" default="false" doc="a near-vertical open-set grasp whose jaw is well off the axes of the target box (across its diagonal) gets a copy turned about its approach onto the nearest box axis whose side fits the gripper, tried first; safe feature flag, off in code" />
  <arg name="open_set_align_jaw_narrowest_side" default="false" doc="with open_set_align_jaw_to_box: the first turned copy closes across the narrowest side of the target box that fits the gripper, also for a grasp that already closes across a wider side; the nearest-side copy comes second, then the original; safe feature flag, off in code" />
  <arg name="skip_pre_open_when_open" default="false" doc="true: the pick skips its gripper pre-open when the finger joint already reads open (within 15 mm of the configured open width), about 0.9 s per pick; no reading or a partly closed gripper opens as before; safe feature flag, off in code" />
  <arg name="grasp_standing_tilt_band" default="false" doc="true: for a standing elongated object taller than 5 cm the pick drops the open-set grasps whose approach is 25 to 65 deg off vertical (they pinch the rim and the object tips at the place); the unfiltered grasps stay when none is left; careful feature flag, off in code" />
  <arg name="grasp_regrasp_on_overclose" default="false" doc="true: after the close the finger angle is compared with the one flat pads show on the perceived object width; closed 20 mm or more past it (a fingertip pinch) the gripper opens, goes deeper by the excess (at most 3 cm, never into the table, never on a backed-off grasp) and closes again before the lift; careful feature flag, off in code" />
  <arg name="open_set_strip_reported_padding" default="false" doc="take off the padding the open-set detection reports for its box (box_padding of the detected object) instead of open_set_box_padding, which stays the fallback for a detection without it; careful flag, off by default" />
  <arg name="insert_cable_gate" default="false" doc="true: rank insert poses by predicted cable stretch and offer likely safe ones first (#219); safe feature flag, off in code" />
  <arg name="cable_detour_mode" default="hack" doc="hack: the closed-set objects visit the fixed untangle poses before a pick, place and insert, as always; cable_aware: no untangle pose at all (also no cable replay detour), the MTC cable guard is the protection and a refused motion fails with a clear text; careful flag, hack in the code" />
  <arg name="open_set_place_clearance_by_height" default="false" doc="true: release tall open-set objects at 1 cm and other open-set objects at 4 cm above their support (#202); careful feature flag, off in code" />
  <arg name="place_same_orientation_as_picked" default="true" doc="false: small objects (e.g. balls, fruit) are inserted with the gripper pointing straight down and the wrist turned as little as possible, instead of in the orientation they were grasped in (avoids winding up the arm cable)" />
  <arg name="insert_orientation" default="free_yaw" doc="free_yaw (default, #106: keep the picked roll and pitch, choose the yaw for the least wrist rotation), as_picked or gripper_down; empty: place_same_orientation_as_picked decides (true: as_picked, false: gripper_down)" />
  <arg name="cable_monitor" default="false" doc="true: start the observe-only arm cable monitor (mobipick_cable_entanglement, #118 #121): in the sim it presses the simulated UR protective stop when its model predicts an entangled cable; on the real robot it never commands anything and logs every tick and every protective stop for calibration" />
  <arg name="geometric_check" default="true" doc="the carrier link chain alone decides when false; monitor and MTC guard replay (cable_entanglement_monitor.launch)" />
  <arg name="release_after_rest_s" default="0.0" doc="careful flag, off in code: > 0 = the carrier link chain starts afresh when the arm moves again after resting that many seconds" />
  <arg name="release_during_rest" default="false" doc="careful flag, off in code: with release_after_rest_s > 0 the chain starts afresh once the arm has rested that long" />
  <arg name="untangle_with_chain" default="false" doc="safe flag, off in code: the sim untangle service plans from the carried carrier link chain and keeps it through the release" />
  <arg name="reset_at_trajectory_start" default="false" doc="careful flag, off in code: the chain starts afresh when an executed trajectory starts" />
  <arg name="reset_cache_mrad" default="0.0" doc="careful flag, off in code: > 0 = start-pose cache of the settled chain, rounding step in mrad" />

  <!-- #226 several Mobipicks in one sim: the robot's namespace (= its tf prefix), and the namespace of its pose
       selectors ('' = the global /pick_pose_selector_node etc. of a single robot, as before; e.g. mobipick2) -->
  <arg name="namespace" default="mobipick" />
  <arg name="pose_selector_ns" default="" />
  <!-- #226: the robot's map frame (a second Mobipick in its own scene copy: mobipick2/map) -->
  <arg name="map_frame" default="map" />
  <arg name="ps" value="$(eval '/' + arg('pose_selector_ns').strip('/') if arg('pose_selector_ns').strip('/') else '')" />

  <arg name="allow_search_same_table" default="false" doc="allows to search tables again without restarting the planning domain, only works when using hierarchical planning"/>
  <arg name="tables_to_search_at" default="[table_1, table_2, table_3]" doc="list of table names to search at during item and klt search"/>

  <!-- please run separately! : -->
  <!--roslaunch mobipick_bringup mobipick_bringup_both.launch -->

  <!-- 6D pose estimation and classification with deep learning -->
  <!--include file="$(find pbr_dope)/launch/dope.launch"-->

  <!-- MoveIt macros -->
  <include file="$(find robot_api)/launch/moveit_macros.launch">
    <arg name="namespace" value="$(arg namespace)" />
  </include>

  <group if="$(arg simulation)">
    <!-- pose selector: DB to store object poses -->
    <node pkg="pose_selector" type="pose_selector_node" name="pick_pose_selector_node" output="screen"
          ns="/$(arg pose_selector_ns)">
      <param name="debug" value="false" />
      <param name="global_reference_frame" value="$(arg map_frame)" />
      <rosparam param="objects_of_interest" subst_value="True">$(arg objects_of_interest)</rosparam>
      <remap from="/logical_image" to="/$(arg namespace)/eef_main_cam/rgb/logical_image"/>
    </node>

    <!-- Approximate DOPE's lazy visualisation output with the simulated EEF camera image. -->
    <include file="$(find mobipick_gazebo)/launch/mobipick/simulated_dope_image_relay.launch">
      <!-- only passed when non-default: the upstream mobipick_gazebo relay launch has no such args -->
      <arg name="namespace" value="$(arg namespace)" if="$(eval arg('namespace') != 'mobipick')" />
      <arg name="pose_selector_ns" value="$(arg pose_selector_ns)" if="$(eval arg('pose_selector_ns') != '')" />
    </include>

    <!-- force torque observer -->
    <node name="ft_observer" pkg="mobipick_pick_n_place" type="ft_observer_sim.py" ns="$(arg namespace)" output="screen" />
  </group>

  <group unless="$(arg simulation)">
    <!-- pose selector: DB to store object poses -->
    <node pkg="pose_selector" type="dope_converter_node" name="dope_converter_node" output="screen"
          ns="/$(arg pose_selector_ns)">
      <remap from="/dope_output" to="/$(arg namespace)/dope/detected_objects" />
      <rosparam command="load" file="$(arg dope_converter_config)" />
    </node>
    <node pkg="pose_selector" type="pose_selector_node" name="pick_pose_selector_node" output="screen"
          ns="/$(arg pose_selector_ns)">
      <param name="debug" value="false" />
      <param name="global_reference_frame" value="$(arg map_frame)" />
      <rosparam param="objects_of_interest" subst_value="True">$(arg objects_of_interest)</rosparam>
      <remap from="/logical_image" to="$(arg ps)/dope_converter_poses" />
    </node>

    <!-- force torque observer -->
    <node name="ft_observer" pkg="mobipick_pick_n_place" type="ft_observer.py" ns="$(arg namespace)" output="screen"/>
  </group>

  <!-- ::::: Grasp planning ::::: -->
  <include file="$(find tables_demo_bringup)/launch/includes/grasp_planning.launch">
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="planning_scene_config" value="$(find tables_demo_bringup)/config/$(arg world_config)_planning_scene.yaml" />
    <arg name="anygrasp_handles_execution" value="$(arg anygrasp_handles_execution)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="mtc_cable_replay_detour" value="$(arg mtc_cable_replay_detour)" />
    <arg name="open_set_box_padding" value="$(arg open_set_box_padding)" />
    <arg name="open_set_align_jaw_to_box" value="$(arg open_set_align_jaw_to_box)" />
    <arg name="open_set_align_jaw_narrowest_side" value="$(arg open_set_align_jaw_narrowest_side)" />
    <arg name="skip_pre_open_when_open" value="$(arg skip_pre_open_when_open)" />
    <arg name="grasp_standing_tilt_band" value="$(arg grasp_standing_tilt_band)" />
    <arg name="grasp_regrasp_on_overclose" value="$(arg grasp_regrasp_on_overclose)" />
    <arg name="open_set_strip_reported_padding" value="$(arg open_set_strip_reported_padding)" />
    <arg name="mtc_lift_tolerate_touching_neighbours" value="$(arg mtc_lift_tolerate_touching_neighbours)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="pose_selector_ns" value="$(arg pose_selector_ns)" />
    <arg name="map_frame" value="$(arg map_frame)" />
  </include>

  <!-- ::::: Place object ::::: -->
  <include file="$(find tables_demo_bringup)/launch/includes/place.launch">
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="objects_of_interest" value="$(arg objects_of_interest)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="open_set_place_clearance_by_height" value="$(arg open_set_place_clearance_by_height)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="pose_selector_ns" value="$(arg pose_selector_ns)" />
    <arg name="map_frame" value="$(arg map_frame)" />
  </include>

  <!-- ::::: Insert object ::::: -->
  <include file="$(find tables_demo_bringup)/launch/includes/insert.launch">
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="place_same_orientation_as_picked" value="$(arg place_same_orientation_as_picked)" />
    <arg name="insert_orientation" value="$(arg insert_orientation)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="insert_cable_gate" value="$(arg insert_cable_gate)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="pose_selector_ns" value="$(arg pose_selector_ns)" />
    <arg name="map_frame" value="$(arg map_frame)" />
  </include>

  <!-- ::::: Arm cable monitor (observe-only; sim: presses the sim protective stop, real: logs) :::::
       mobipick_cable_entanglement (mobipick repository); off by default, so the include is skipped -->
  <include if="$(arg cable_monitor)" file="$(find mobipick_cable_entanglement)/launch/cable_entanglement_monitor.launch">
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="geometric_check" value="$(arg geometric_check)" />
    <arg name="release_after_rest_s" value="$(arg release_after_rest_s)" />
    <arg name="release_during_rest" value="$(arg release_during_rest)" />
    <arg name="untangle_with_chain" value="$(arg untangle_with_chain)" />
    <arg name="reset_at_trajectory_start" value="$(arg reset_at_trajectory_start)" />
    <arg name="reset_cache_mrad" value="$(arg reset_cache_mrad)" />
  </include>

  <!-- config for tables_demo_planning -->
  <rosparam command="load" file="$(find mobipick_pick_n_place)/config/$(arg world_config)_demo.yaml" ns="$(arg namespace)/tables_demo_planning" />
  <!-- config for items used in the demos-->
  <rosparam command="load" file="$(find tables_demo_bringup)/config/initial_items.yaml" ns="$(arg namespace)/tables_demo_planning" />
  <rosparam param="allow_search_same_table" ns="$(arg namespace)/tables_demo_planning" subst_value="True">$(arg allow_search_same_table)</rosparam>
  <rosparam param="tables_to_search_at" ns="$(arg namespace)/tables_demo_planning" subst_value="True">$(arg tables_to_search_at)</rosparam>
</launch>
