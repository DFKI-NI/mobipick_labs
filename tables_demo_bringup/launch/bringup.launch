<?xml version="1.0"?>
<launch>
  <arg name="simulation" default="false" />
  <arg name="world_config" default="moelk_tables" doc="objects arrangement, options: moelk_tables, cic_tables" />
  <arg name="objects_of_interest" default="[relay, screwdriver, multimeter, power_drill_with_grip, hot_glue_gun, klt, bleach, mustard, soup, meat]"/>
  <arg name="dope_converter_config" default="$(find pbr_objects)/config/class_ids.yaml" />
  <arg name="anygrasp_handles_execution" default="false" />
  <arg name="use_mtc" default="true" doc="true (the default): plan and execute grasplan pick, place and insert with MoveIt Task Constructor; false: the MoveIt pick n place pipeline (move_group pickup/place actions). Independent of the arm cable plan check (mtc_cable_plan_check, experimental)" />
  <arg name="mtc_lift_tolerate_touching_neighbours" default="false" doc="allow a just-attached object to clear only box neighbours already touching it during a straight-up MTC lift (careful flag, off in code)" />
  <arg name="mtc_cable_constraints" default="false" doc="old name of mtc_cable_plan_check, still accepted" />
  <arg name="mtc_cable_plan_check" default="$(arg mtc_cable_constraints)" doc="Experimental. true (with use_mtc): check every planned MTC joint path against the arm cable model (mobipick_cable_entanglement) and throw away a plan that would stretch the cable tube, then try the next one; the same switch also makes the free motions keep wrist_3 within a window around its least-wound angle, a planning constraint (the real robot's wrist_3 limits are tighter than that window, so there only the check acts)" />
  <arg name="mtc_single_plan_pick" default="false" doc="true (with use_mtc): a closed-set pick plans its untangle poses, the grasp and the move to transport as one MTC task and runs it as one plan; the old way (the poses one by one, then the pick) when no grasp plans like that and the arm has not moved; skipped where the cable monitor does not start its chain afresh at each trajectory (the real robot default); careful feature flag, off in code" />
  <arg name="pick_start_move_carrier_stops" default="false" doc="true (with use_mtc and the MTC cable guard): the open-set pick's start move from the grasp view to transport refuses a plan the cable chain replay predicts the monitor to stop, replans, then detours via the observation pose; refused there too, the pick stops without moving; careful feature flag, off in code" />
  <arg name="plan_pick_during_start_move" default="false" doc="true (with use_mtc): a closed-set pick plans and cable-checks its untangle arm poses up front, sends them as one motion and plans the pick with MTC while the arm moves; the plan is used only when the arm arrives where it starts, else it is planned again; careful feature flag, off in code" />
  <arg name="plan_transport_during_pick" default="false" doc="true (with use_mtc): a closed-set pick plans its move to the transport pose from where its MTC solution ends (object attached) while the pick executes, checked by the cable guard like a named move, and moves there right after the pick (planned again from the real state when the arm stands elsewhere); a successful pick then always ends at the transport pose; careful feature flag, off in code" />
  <arg name="mtc_cable_path_shaping" default="false" doc="true (with use_mtc and mtc_cable_plan_check): the arm cable model shapes the path before planning: the IK branch with the most cable slack, model-chosen joint waypoints and a wrist corridor; the cable guard stays the final check; careful feature flag, off in code" />
  <arg name="mtc_cable_support_margin" default="false" doc="true (with mtc_cable_plan_check): with the support wrist anchor (the sim) the MTC cable guard plans with a -0.07 geometric stretch margin instead of -0.115, so fewer arm paths are rejected as entangling; careful feature flag, off in code" />
  <arg name="external_grasp_ik_timeout" default="0.1" doc="seconds per compute_ik call of the open-set IK pre-filter; the sim profile passes 0.01 (each call spends its whole timeout)" />
  <arg name="open_set_pick_from_current_state" default="false" doc="plan the open-set pick from the arm pose it is at and move to transport only to retry; safe feature flag, off in code, on in the sim" />
  <arg name="drop_floating_boxes_at_target" default="0.0" doc="metres a detector box may float above its support before it is left out of the pick scene (0 = off); safe feature flag, the sim profile passes 0.03" />
  <arg name="place_sample_within_reach" default="false" doc="sample place poses within the arm reach disk first; safe feature flag, off in code, on in the sim" />
  <arg name="place_free_footprints_first" default="false" doc="try place poses with a free footprint first; safe feature flag, off in code, on in the sim" />
  <arg name="place_drop_implausible_boxes" default="false" doc="leave implausible detector boxes out of the place scene; safe feature flag, off in code, on in the sim" />
  <arg name="mtc_cable_guard_named_moves" default="log" doc="with use_mtc and the MTC cable guard: enforce (refuse and replan named arm moves), log (only log) or off; careful feature flag, log in code, enforce in the sim" />
  <arg name="mtc_place_reject_octomap_occupied" default="false" doc="with use_mtc: refuse place poses where the octomap sees an obstacle; safe feature flag, off in code, on in the sim" />
  <arg name="mtc_grasp_check_squeeze" default="false" doc="with use_mtc: close fully after the preset width before calling a pick held; safe feature flag, off in code, on in the sim" />
  <arg name="mtc_cable_replay_live_state" default="false" doc="true (with mtc_cable_plan_check): the cable guard's replay of a planned path through the carrier link chain goes on from the cable monitor's live chain (its chain_state service) and the path must also pass a replay from a fresh chain (both must pass), so the guard sees what the motions before the path did; the fresh chain is also what is used where the monitor resets its chain at every trajectory start; careful feature flag, off in code" />
  <arg name="mtc_cable_replay_detour" default="false" doc="true (with mtc_cable_plan_check): when the cable guard refused a closed-set pick by its chain replay alone, move the arm to untangle_cable_guide_2_right as a separate motion and plan the pick once more from there; no detour while the named-move guard only logs (the real robot default); careful feature flag, off in code" />
  <arg name="open_set_box_padding" default="0.0" doc="metres taken off every side of the open-set detector box of the target before it goes into the planning scene and the grasp geometry (the detector pads every side); 0.0 keeps the box as detected; careful feature flag, off in code" />
  <arg name="open_set_align_jaw_to_box" default="false" doc="a near-vertical open-set grasp whose jaw is well off the axes of the target box (across its diagonal) gets a copy turned about its approach onto the nearest box axis whose side fits the gripper, tried first; safe feature flag, off in code" />
  <arg name="open_set_align_jaw_narrowest_side" default="false" doc="with open_set_align_jaw_to_box: the first turned copy closes across the narrowest side of the target box that fits the gripper, also for a grasp that already closes across a wider side; the nearest-side copy comes second, then the original; careful feature flag, off in code" />
  <arg name="skip_pre_open_when_open" default="false" doc="true: the pick skips its gripper pre-open when the finger joint already reads open (within 15 mm of the configured open width), about 0.9 s per pick; no reading or a partly closed gripper opens as before; safe feature flag, off in code" />
  <arg name="plan_cache_named_moves" default="false" doc="true: a named arm move of the pick (the untangle poses, transport, the planned start move) that starts within 5 mrad of a plan the cable guard passed before, under the same guard settings, runs that plan again with its verdict once its path is collision free in the current planning scene, instead of planning and replaying the cable chain again; careful feature flag, off in code" />
  <arg name="grasp_standing_tilt_band" default="false" doc="true: for a standing elongated object taller than 5 cm the pick drops the open-set grasps whose approach is 25 to 65 deg off vertical (they pinch the rim and the object tips at the place); the unfiltered grasps stay when none is left; careful feature flag, off in code" />
  <arg name="grasp_pinch_retry_next" default="false" doc="true: after a pinch verdict of an open-set MTC pick the arm backs out straight along the approach, returns to the pick start pose and the untried grasps predicted to pass the cable guard are offered, at most grasp_pinch_retry_max (2) more times; only fires where grasp_standing_tilt_band runs the pinch check and with mtc_cable_plan_check on; safe feature flag, off in code" />
  <arg name="grasp_regrasp_on_overclose" default="false" doc="true: after the close the finger angle is compared with the one flat pads show on the perceived object width; closed 20 mm or more past it (a fingertip pinch) the gripper opens, goes deeper by the excess (at most 3 cm, never into the table, never on a backed-off grasp) and closes again before the lift; careful feature flag, off in code" />
  <arg name="grasp_shape_features" default="false" doc="true: the open-set pick decides top-only versus side grasps from the shape features measured on the point cloud of the detection (height, outline, footprint) instead of the box alone; no shape message = the box rule; careful feature flag, off in code" />
  <arg name="open_set_strip_reported_padding" default="false" doc="take off the padding the open-set detection reports for its box (box_padding of the detected object) instead of open_set_box_padding, which stays the fallback for a detection without it; careful flag, off by default" />
  <arg name="insert_cable_gate" default="false" doc="true: rank insert poses by predicted cable stretch and offer likely safe ones first; safe feature flag, off in code" />
  <arg name="cable_detour_mode" default="hack" doc="hack: the closed-set objects visit the fixed untangle poses before a pick, place and insert, as always; cable_aware: no untangle pose at all (also no cable replay detour), the MTC cable guard is the protection and a refused motion fails with a clear text; careful flag, hack in the code" />
  <arg name="use_mesh_object_heights" default="false" doc="true: insert pose heights of the closed-set table classes come from the recognised mesh box instead of the hand-typed table (the release pose of the glue gun, meat and mustard moves down by up to 2.2 cm); careful feature flag, off in code" />
  <arg name="place_same_orientation_as_picked" default="true" doc="false: small objects (e.g. balls, fruit) are inserted with the gripper pointing straight down and the wrist turned as little as possible, instead of in the orientation they were grasped in (avoids winding up the arm cable)" />
  <arg name="insert_orientation" default="free_yaw" doc="free_yaw (default: keep the picked roll and pitch, choose the yaw for the least wrist rotation), as_picked or gripper_down; empty: place_same_orientation_as_picked decides (true: as_picked, false: gripper_down)" />
  <arg name="cable_monitor" default="false" doc="true: start the observe-only arm cable monitor (mobipick_cable_entanglement): in the sim it presses the simulated UR protective stop when its model predicts an entangled cable; on the real robot it never commands anything and logs every tick and every protective stop for calibration" />
  <arg name="cable_wrist_anchor" default="carrier_tip" doc="carrier_tip or support: support lets the cable model judge the wrist span from the forearm support instead of the tip of the guide tube; careful flag, carrier_tip (the real-robot value) in the code; the simulation is started with support" />
  <arg name="geometric_check" default="true" doc="the carrier link chain alone decides when false; monitor and MTC guard replay (cable_entanglement_monitor.launch)" />
  <arg name="release_after_rest_s" default="0.0" doc="careful flag, off in code: > 0 = the carrier link chain starts afresh when the arm moves again after resting that many seconds" />
  <arg name="release_during_rest" default="false" doc="careful flag, off in code: with release_after_rest_s > 0 the chain starts afresh once the arm has rested that long" />
  <arg name="untangle_with_chain" default="false" doc="safe flag, off in code, simulation only: the sim untangle service plans from the carried carrier link chain and keeps it through the release; ignored on the real robot, where the monitor offers no untangle" />
  <arg name="reset_at_trajectory_start" default="false" doc="careful flag, off in code: the chain starts afresh when an executed trajectory starts" />
  <arg name="reset_cache_mrad" default="0.0" doc="careful flag, off in code: > 0 = start-pose cache of the settled chain, rounding step in mrad" />

  <!-- Several Mobipicks in one sim: the robot's namespace (= its tf prefix), and the namespace of its pose
       selectors ('' = the global /pick_pose_selector_node etc. of a single robot, as before; e.g. mobipick2) -->
  <arg name="namespace" default="mobipick" />
  <arg name="pose_selector_ns" default="" />
  <!-- The robot's map frame (a second Mobipick in its own scene copy: mobipick2/map) -->
  <arg name="map_frame" default="map" />
  <arg name="ps" value="$(eval '/' + arg('pose_selector_ns').strip('/') if arg('pose_selector_ns').strip('/') else '')" />

  <arg name="allow_search_same_table" default="false" doc="allows to search tables again without restarting the planning domain, only works when using hierarchical planning"/>
  <arg name="tables_to_search_at" default="[table_1, table_2, table_3]" doc="list of table names to search at during item and klt search"/>

  <!-- please run separately! : -->
  <!--roslaunch mobipick_bringup mobipick_bringup_both.launch -->

  <!-- 6D pose estimation and classification with deep learning -->
  <!--include file="$(find pbr_dope)/launch/dope.launch"-->

  <!-- MoveIt macros -->
  <include file="$(find robot_api)/launch/moveit_macros.launch">
    <arg name="namespace" value="$(arg namespace)" />
  </include>

  <group if="$(arg simulation)">
    <!-- pose selector: DB to store object poses -->
    <node pkg="pose_selector" type="pose_selector_node" name="pick_pose_selector_node" output="screen"
          ns="/$(arg pose_selector_ns)">
      <param name="debug" value="false" />
      <param name="global_reference_frame" value="$(arg map_frame)" />
      <rosparam param="objects_of_interest" subst_value="True">$(arg objects_of_interest)</rosparam>
      <remap from="/logical_image" to="/$(arg namespace)/eef_main_cam/rgb/logical_image"/>
    </node>

    <!-- Approximate DOPE's lazy visualisation output with the simulated EEF camera image. -->
    <include file="$(find mobipick_gazebo)/launch/mobipick/simulated_dope_image_relay.launch">
      <!-- only passed when non-default: the upstream mobipick_gazebo relay launch has no such args -->
      <arg name="namespace" value="$(arg namespace)" if="$(eval arg('namespace') != 'mobipick')" />
      <arg name="pose_selector_ns" value="$(arg pose_selector_ns)" if="$(eval arg('pose_selector_ns') != '')" />
    </include>

    <!-- force torque observer -->
    <node name="ft_observer" pkg="mobipick_pick_n_place" type="ft_observer_sim.py" ns="$(arg namespace)" output="screen" />
  </group>

  <group unless="$(arg simulation)">
    <!-- pose selector: DB to store object poses -->
    <node pkg="pose_selector" type="dope_converter_node" name="dope_converter_node" output="screen"
          ns="/$(arg pose_selector_ns)">
      <remap from="/dope_output" to="/$(arg namespace)/dope/detected_objects" />
      <rosparam command="load" file="$(arg dope_converter_config)" />
    </node>
    <node pkg="pose_selector" type="pose_selector_node" name="pick_pose_selector_node" output="screen"
          ns="/$(arg pose_selector_ns)">
      <param name="debug" value="false" />
      <param name="global_reference_frame" value="$(arg map_frame)" />
      <rosparam param="objects_of_interest" subst_value="True">$(arg objects_of_interest)</rosparam>
      <remap from="/logical_image" to="$(arg ps)/dope_converter_poses" />
    </node>

    <!-- force torque observer -->
    <node name="ft_observer" pkg="mobipick_pick_n_place" type="ft_observer.py" ns="$(arg namespace)" output="screen"/>
  </group>

  <!-- ::::: Grasp planning ::::: -->
  <include file="$(find tables_demo_bringup)/launch/includes/grasp_planning.launch">
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="planning_scene_config" value="$(find tables_demo_bringup)/config/$(arg world_config)_planning_scene.yaml" />
    <arg name="anygrasp_handles_execution" value="$(arg anygrasp_handles_execution)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="mtc_single_plan_pick" value="$(arg mtc_single_plan_pick)" />
    <arg name="pick_start_move_carrier_stops" value="$(arg pick_start_move_carrier_stops)" />
    <arg name="plan_pick_during_start_move" value="$(arg plan_pick_during_start_move)" />
    <arg name="plan_transport_during_pick" value="$(arg plan_transport_during_pick)" />
    <arg name="mtc_cable_path_shaping" value="$(arg mtc_cable_path_shaping)" />
    <arg name="mtc_cable_support_margin" value="$(arg mtc_cable_support_margin)" />
    <arg name="external_grasp_ik_timeout" value="$(arg external_grasp_ik_timeout)" />
    <arg name="open_set_pick_from_current_state" value="$(arg open_set_pick_from_current_state)" />
    <arg name="drop_floating_boxes_at_target" value="$(arg drop_floating_boxes_at_target)" />
    <arg name="mtc_cable_guard_named_moves" value="$(arg mtc_cable_guard_named_moves)" />
    <arg name="mtc_place_reject_octomap_occupied" value="$(arg mtc_place_reject_octomap_occupied)" />
    <arg name="mtc_grasp_check_squeeze" value="$(arg mtc_grasp_check_squeeze)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="mtc_cable_replay_detour" value="$(arg mtc_cable_replay_detour)" />
    <arg name="open_set_box_padding" value="$(arg open_set_box_padding)" />
    <arg name="open_set_align_jaw_to_box" value="$(arg open_set_align_jaw_to_box)" />
    <arg name="open_set_align_jaw_narrowest_side" value="$(arg open_set_align_jaw_narrowest_side)" />
    <arg name="skip_pre_open_when_open" value="$(arg skip_pre_open_when_open)" />
    <arg name="plan_cache_named_moves" value="$(arg plan_cache_named_moves)" />
    <arg name="grasp_standing_tilt_band" value="$(arg grasp_standing_tilt_band)" />
    <arg name="grasp_pinch_retry_next" value="$(arg grasp_pinch_retry_next)" />
    <arg name="grasp_regrasp_on_overclose" value="$(arg grasp_regrasp_on_overclose)" />
    <arg name="grasp_shape_features" value="$(arg grasp_shape_features)" />
    <arg name="open_set_strip_reported_padding" value="$(arg open_set_strip_reported_padding)" />
    <arg name="mtc_lift_tolerate_touching_neighbours" value="$(arg mtc_lift_tolerate_touching_neighbours)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="pose_selector_ns" value="$(arg pose_selector_ns)" />
    <arg name="map_frame" value="$(arg map_frame)" />
  </include>

  <!-- ::::: Place object ::::: -->
  <include file="$(find tables_demo_bringup)/launch/includes/place.launch">
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="objects_of_interest" value="$(arg objects_of_interest)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="mtc_cable_path_shaping" value="$(arg mtc_cable_path_shaping)" />
    <arg name="mtc_cable_support_margin" value="$(arg mtc_cable_support_margin)" />
    <arg name="place_sample_within_reach" value="$(arg place_sample_within_reach)" />
    <arg name="place_free_footprints_first" value="$(arg place_free_footprints_first)" />
    <arg name="place_drop_implausible_boxes" value="$(arg place_drop_implausible_boxes)" />
    <arg name="mtc_cable_guard_named_moves" value="$(arg mtc_cable_guard_named_moves)" />
    <arg name="mtc_place_reject_octomap_occupied" value="$(arg mtc_place_reject_octomap_occupied)" />
    <arg name="mtc_grasp_check_squeeze" value="$(arg mtc_grasp_check_squeeze)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="pose_selector_ns" value="$(arg pose_selector_ns)" />
    <arg name="map_frame" value="$(arg map_frame)" />
  </include>

  <!-- ::::: Insert object ::::: -->
  <include file="$(find tables_demo_bringup)/launch/includes/insert.launch">
    <arg name="cable_detour_mode" value="$(arg cable_detour_mode)" />
    <arg name="place_same_orientation_as_picked" value="$(arg place_same_orientation_as_picked)" />
    <arg name="insert_orientation" value="$(arg insert_orientation)" />
    <arg name="use_mtc" value="$(arg use_mtc)" />
    <arg name="mtc_cable_plan_check" value="$(arg mtc_cable_plan_check)" />
    <arg name="mtc_cable_path_shaping" value="$(arg mtc_cable_path_shaping)" />
    <arg name="mtc_cable_support_margin" value="$(arg mtc_cable_support_margin)" />
    <arg name="mtc_cable_guard_named_moves" value="$(arg mtc_cable_guard_named_moves)" />
    <arg name="mtc_place_reject_octomap_occupied" value="$(arg mtc_place_reject_octomap_occupied)" />
    <arg name="mtc_grasp_check_squeeze" value="$(arg mtc_grasp_check_squeeze)" />
    <arg name="place_sample_within_reach" value="$(arg place_sample_within_reach)" />
    <arg name="place_free_footprints_first" value="$(arg place_free_footprints_first)" />
    <arg name="place_drop_implausible_boxes" value="$(arg place_drop_implausible_boxes)" />
    <arg name="mtc_cable_replay_live_state" value="$(arg mtc_cable_replay_live_state)" />
    <arg name="insert_cable_gate" value="$(arg insert_cable_gate)" />
    <arg name="use_mesh_object_heights" value="$(arg use_mesh_object_heights)" />
    <arg name="namespace" value="$(arg namespace)" />
    <arg name="pose_selector_ns" value="$(arg pose_selector_ns)" />
    <arg name="map_frame" value="$(arg map_frame)" />
  </include>

  <!-- the cable model's wrist span anchor, simulation-wide (the cable model reads /cable_model/wrist_anchor); demo_sim.launch
       passes cable_wrist_anchor on to this file, so only this file sets it -->
  <param name="/cable_model/wrist_anchor" value="$(arg cable_wrist_anchor)" />

  <!-- ::::: Arm cable monitor (observe-only; sim: presses the sim protective stop, real: logs) :::::
       mobipick_cable_entanglement (mobipick repository); off by default, so the include is skipped -->
  <include if="$(arg cable_monitor)" file="$(find mobipick_cable_entanglement)/launch/cable_entanglement_monitor.launch">
    <arg name="namespace" value="$(arg namespace)" />
    <!-- the launch structure says sim or real robot: the simulation-only parts (protective stop presses, untangle
         services) never start on the real robot -->
    <arg name="mode" value="$(eval 'sim' if simulation else 'real')" />
    <arg name="geometric_check" value="$(arg geometric_check)" />
    <arg name="release_after_rest_s" value="$(arg release_after_rest_s)" />
    <arg name="release_during_rest" value="$(arg release_during_rest)" />
    <arg name="untangle_with_chain" value="$(arg untangle_with_chain)" />
    <arg name="reset_at_trajectory_start" value="$(arg reset_at_trajectory_start)" />
    <arg name="reset_cache_mrad" value="$(arg reset_cache_mrad)" />
  </include>

  <!-- config for tables_demo_planning -->
  <rosparam command="load" file="$(find mobipick_pick_n_place)/config/$(arg world_config)_demo.yaml" ns="$(arg namespace)/tables_demo_planning" />
  <!-- config for items used in the demos-->
  <rosparam command="load" file="$(find tables_demo_bringup)/config/initial_items.yaml" ns="$(arg namespace)/tables_demo_planning" />
  <rosparam param="allow_search_same_table" ns="$(arg namespace)/tables_demo_planning" subst_value="True">$(arg allow_search_same_table)</rosparam>
  <rosparam param="tables_to_search_at" ns="$(arg namespace)/tables_demo_planning" subst_value="True">$(arg tables_to_search_at)</rosparam>
</launch>
