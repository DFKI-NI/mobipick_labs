<?xml version="1.0"?>
<launch>
  <arg name="planning_scene_config" default="$(find tables_demo_bringup)/config/moelk_tables_planning_scene.yaml" />
  <arg name="anygrasp_handles_execution" default="false" />
  <arg name="use_mtc" default="false" doc="true: plan and execute grasplan pick, place and insert with MoveIt Task Constructor instead of the MoveIt pick n place pipeline (move_group pickup/place actions)" />
  <arg name="mtc_lift_tolerate_touching_neighbours" default="false" doc="allow a just-attached object to clear only box neighbours already touching it during a straight-up MTC lift (careful flag, off in code)" />
  <arg name="mtc_cable_plan_check" default="false" doc="true (with use_mtc): check every planned MTC joint path against the arm cable model (mobipick_cable_entanglement) and throw away a plan that would stretch the cable tube, then try the next one; the same switch also makes the free motions keep wrist_3 within a window around its least-wound angle, a planning constraint (the real robot's wrist_3 limits are tighter than that window, so there only the check acts)" />
  <arg name="pick_start_move_carrier_stops" default="false" doc="true (with use_mtc and the MTC cable guard): the open-set pick's start move from the grasp view to transport refuses a plan the cable chain replay predicts the monitor to stop, replans, then detours via the observation pose; refused there too, the pick stops without moving; careful feature flag, off in code" />
  <arg name="plan_pick_during_start_move" default="false" doc="true (with use_mtc): a closed-set pick plans and cable-checks its untangle arm poses up front, sends them as one motion and plans the pick with MTC while the arm moves; the plan is used only when the arm arrives where it starts, else it is planned again; careful feature flag, off in code" />
  <arg name="mtc_cable_path_shaping" default="false" doc="true (with use_mtc and mtc_cable_plan_check): the arm cable model shapes the path before planning: the IK branch with the most cable slack, model-chosen joint waypoints and a wrist corridor; the cable guard stays the final check; careful feature flag, off in code" />
  <arg name="mtc_cable_support_margin" default="false" doc="true (with mtc_cable_plan_check): with the support wrist anchor (the sim) the MTC cable guard plans with a -0.07 geometric stretch margin instead of -0.115, so fewer arm paths are rejected as entangling; careful feature flag, off in code" />
  <arg name="mtc_cable_replay_live_state" default="false" doc="true (with mtc_cable_plan_check): the cable guard's replay of a planned path through the carrier link chain goes on from the cable monitor's live chain (its chain_state service) and the path must also pass a replay from a fresh chain (both must pass), so the guard sees what the motions before the path did; the fresh chain is also what is used where the monitor resets its chain at every trajectory start; careful feature flag, off in code" />
  <arg name="mtc_cable_replay_detour" default="false" doc="true (with mtc_cable_plan_check): when the cable guard refused a closed-set pick by its chain replay alone, move the arm to untangle_cable_guide_2_right as a separate motion and plan the pick once more from there; no detour while the named-move guard only logs (the real robot default); careful feature flag, off in code" />
  <arg name="open_set_box_padding" default="0.0" doc="metres taken off every side of the open-set detector box of the target before it goes into the planning scene and the grasp geometry (the detector pads every side); 0.0 keeps the box as detected; careful feature flag, off in code" />
  <arg name="cable_detour_mode" default="hack" doc="hack: the closed-set objects visit the fixed untangle poses before a pick, place and insert, as always; cable_aware: no untangle pose at all (also no cable replay detour), the MTC cable guard is the protection and a refused motion fails with a clear text; careful flag, hack in the code" />
  <arg name="open_set_align_jaw_to_box" default="false" doc="a near-vertical open-set grasp whose jaw is well off the axes of the target box (across its diagonal) gets a copy turned about its approach onto the nearest box axis whose side fits the gripper, tried first; safe feature flag, off in code" />
  <arg name="open_set_align_jaw_narrowest_side" default="false" doc="with open_set_align_jaw_to_box: the first turned copy closes across the narrowest side of the target box that fits the gripper, also for a grasp that already closes across a wider side; the nearest-side copy comes second, then the original; careful feature flag, off in code" />
  <arg name="skip_pre_open_when_open" default="false" doc="true: the pick skips its gripper pre-open when the finger joint already reads open (within 15 mm of the configured open width), about 0.9 s per pick; no reading or a partly closed gripper opens as before; safe feature flag, off in code" />
  <arg name="grasp_standing_tilt_band" default="false" doc="true: for a standing elongated object taller than 5 cm the pick drops the open-set grasps whose approach is 25 to 65 deg off vertical (they pinch the rim and the object tips at the place); the unfiltered grasps stay when none is left; careful feature flag, off in code" />
  <arg name="grasp_regrasp_on_overclose" default="false" doc="true: after the close the finger angle is compared with the one flat pads show on the perceived object width; closed 20 mm or more past it (a fingertip pinch) the gripper opens, goes deeper by the excess (at most 3 cm, never into the table, never on a backed-off grasp) and closes again before the lift; careful feature flag, off in code" />
  <arg name="open_set_strip_reported_padding" default="false" doc="take off the padding the open-set detection reports for its box (box_padding of the detected object) instead of open_set_box_padding, which stays the fallback for a detection without it; careful flag, off by default" />
  <!-- GripperCommand.max_effort used for AnyGrasp grasps of unknown objects; the Robotiq action server
       accepts 30..100, the simulated gripper maps it to a real torque limit. -1 keeps gripper_joint_efforts. -->
  <arg name="anygrasp_gripper_max_effort" default="50.0" />
  <arg name="anygrasp_use_gripper_width" default="false" />
  <!-- Several Mobipicks in one sim: the robot's namespace (= its tf prefix), and the namespace of its pose
       selectors ('' = the global /pick_pose_selector_node etc. of a single robot, as before; e.g. mobipick2) -->
  <arg name="namespace" default="mobipick" />
  <arg name="pose_selector_ns" default="" />
  <!-- The robot's map frame (a second Mobipick in its own scene copy: mobipick2/map) -->
  <arg name="map_frame" default="map" />
  <arg name="ps" value="$(eval '/' + arg('pose_selector_ns').strip('/') if arg('pose_selector_ns').strip('/') else '')" />

  <!-- visualise the poses inside the pose selector as textured meshes -->
  <arg name="object_color_rgba_pick" value="[0,0,0,0]"/>
  <node pkg="pose_selector" type="pose_selector_visualizer.py" name="pick_pose_selector_visualiser" output="screen"
        ns="/$(arg pose_selector_ns)">
    <rosparam command="load" file="$(find pbr_objects)/config/textured_meshes.yaml" /> <!-- Path to mesh objects config file -->
    <rosparam param="object_color_rgba" subst_value="True">$(arg object_color_rgba_pick)</rosparam>
    <remap from="/pose_selector_get_all_service" to="$(arg ps)/pick_pose_selector_node/pose_selector_get_all" />
  </node>

  <!-- visualise grasps ( draws multiple brown grippers :1 per grasp ; as mesh in rviz using visualisation marker array ) -->
  <node pkg="grasplan" type="rviz_gripper_visualizer.py" name="rviz_gripper_visualizer" output="screen"
        ns="/$(arg pose_selector_ns)">
    <param name="global_reference_frame" type="string" value="$(arg map_frame)" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/gripper_open_transformations.yaml" command="load" ns="gripper_transformations"/>
    <remap from="pose_array" to="/$(arg namespace)/pick_object_node/grasp_poses"/>
  </node>
  <!-- pick object script using handcoded grasp planner
       (grasps  defined manually using grasp editor or recorded via gazebo zero gravity environment) -->
  <node pkg="grasplan" type="pick.py" name="pick_object_node" output="screen" ns="$(arg namespace)" required="true">
    <param name="import_file" type="string" value="grasplan.grasp_planner.handcoded_grasp_planner" />
    <param name="import_class" type="string" value="HandcodedGraspPlanner" />
    <param name="global_reference_frame" type="string" value="$(arg map_frame)" />
    <param name="pose_selector_activate_srv_name" type="string" value="$(arg ps)/pick_pose_selector_node/pose_selector_activate" />
    <param name="pose_selector_class_query_srv_name" type="string" value="$(arg ps)/pick_pose_selector_node/pose_selector_class_query" />
    <param name="pose_selector_get_all_poses_srv_name" type="string" value="$(arg ps)/pick_pose_selector_node/pose_selector_get_all" />
    <param name="pose_selector_delete_srv_name" type="string" value="$(arg ps)/pick_pose_selector_node/pose_selector_delete" />
    <param name="detach_all_objects" value="true" />
    <param name="anygrasp_handles_execution" type="bool" value="$(arg anygrasp_handles_execution)" />
    <param name="use_mtc" type="bool" value="$(arg use_mtc)" />
    <param name="mtc_cable_plan_check" type="bool" value="$(arg mtc_cable_plan_check)" />
    <param name="pick_start_move_carrier_stops" type="bool" value="$(arg pick_start_move_carrier_stops)" />
    <param name="plan_pick_during_start_move" type="bool" value="$(arg plan_pick_during_start_move)" />
    <param name="mtc_cable_path_shaping" type="bool" value="$(arg mtc_cable_path_shaping)" />
    <param name="mtc_cable_support_margin" type="bool" value="$(arg mtc_cable_support_margin)" />
    <param name="mtc_cable_replay_live_state" type="bool" value="$(arg mtc_cable_replay_live_state)" />
    <param name="mtc_cable_replay_detour" type="bool" value="$(arg mtc_cable_replay_detour)" />
    <param name="open_set_box_padding" type="double" value="$(arg open_set_box_padding)" />
    <param name="cable_detour_mode" type="string" value="$(arg cable_detour_mode)" />
    <param name="open_set_align_jaw_to_box" type="bool" value="$(arg open_set_align_jaw_to_box)" />
    <param name="open_set_align_jaw_narrowest_side" type="bool" value="$(arg open_set_align_jaw_narrowest_side)" />
    <param name="skip_pre_open_when_open" type="bool" value="$(arg skip_pre_open_when_open)" />
    <param name="grasp_standing_tilt_band" type="bool" value="$(arg grasp_standing_tilt_band)" />
    <param name="grasp_regrasp_on_overclose" type="bool" value="$(arg grasp_regrasp_on_overclose)" />
    <param name="open_set_strip_reported_padding" type="bool" value="$(arg open_set_strip_reported_padding)" />
    <param name="mtc_lift_tolerate_touching_neighbours" type="bool" value="$(arg mtc_lift_tolerate_touching_neighbours)" />
    <param name="anygrasp_gripper_max_effort" type="double" value="$(arg anygrasp_gripper_max_effort)" />
    <param name="anygrasp_use_gripper_width" type="bool" value="$(arg anygrasp_use_gripper_width)" />
    <!-- no need to perceive the object in grasplan, planning handles it -->
    <param name="perceive_object" value="false" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/pick_params.yaml" command="load" />
    <rosparam file="$(arg planning_scene_config)" command="load" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/grasp_planning_core_params.yaml" command="load" />
    <!-- allows to specify how much the gripper should close per object -->
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/gripper_distance_values_per_object.yaml" command="load" />
    <!-- pregrasp planner parameters -->
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_relay.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_screwdriver.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_multimeter.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_klt.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_power_drill_with_grip.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_hot_glue_gun.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_soup.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_bleach.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_mustard.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/object_grasps/handcoded_grasp_planner_meat.yaml"
              command="load" ns="handcoded_grasp_planner_transforms" />
  </node>

</launch>
