<?xml version="1.0"?>
<launch>
  <arg name="place_same_orientation_as_picked" default="true" doc="false: small objects (e.g. balls, fruit) are inserted with the gripper pointing straight down and the wrist turned as little as possible, instead of in the orientation they were grasped in (avoids winding up the arm cable)" />
  <arg name="insert_orientation" default="free_yaw" doc="free_yaw (default, #106: keep the picked roll and pitch, choose the yaw for the least wrist rotation), as_picked or gripper_down; empty: place_same_orientation_as_picked decides (true: as_picked, false: gripper_down)" />

  <!-- #226 several Mobipicks in one sim: the robot's namespace (= its tf prefix), and the namespace of its pose
       selectors ('' = the global /pick_pose_selector_node etc. of a single robot, as before; e.g. mobipick2) -->
  <arg name="namespace" default="mobipick" />
  <arg name="pose_selector_ns" default="" />
  <!-- #226: the robot's map frame (a second Mobipick in its own scene copy: mobipick2/map) -->
  <arg name="map_frame" default="map" />
  <arg name="ps" value="$(eval '/' + arg('pose_selector_ns').strip('/') if arg('pose_selector_ns').strip('/') else '')" />
  <arg name="use_mtc" default="false" doc="true: plan and execute grasplan pick, place and insert with MoveIt Task Constructor instead of the MoveIt pick n place pipeline (move_group pickup/place actions)" />
  <arg name="mtc_cable_plan_check" default="false" doc="true (with use_mtc): check every planned MTC joint path against the arm cable model (mobipick_cable_entanglement) and throw away a plan that would stretch the cable tube, then try the next one; the same switch also makes the free motions keep wrist_3 within a window around its least-wound angle, a planning constraint (the real robot's wrist_3 limits are tighter than that window, so there only the check acts)" />
  <arg name="mtc_cable_replay_live_state" default="false" doc="true (with mtc_cable_plan_check): the cable guard's replay of a planned path through the carrier link chain goes on from the cable monitor's live chain (its chain_state service) instead of a fresh chain, so it sees what the motions before the path did; a fresh chain where the monitor resets its chain at every trajectory start; safe feature flag, off in code" />
  <arg name="insert_cable_gate" default="false" doc="true: rank insert poses by predicted cable stretch and offer likely safe ones first (#219); safe feature flag, off in code" />
  <arg name="cable_detour_mode" default="hack" doc="hack: the closed-set objects visit the fixed untangle poses before a pick, place and insert, as always; cable_aware: no untangle pose at all (also no cable replay detour), the MTC cable guard is the protection and a refused motion fails with a clear text; careful flag, hack in the code" />

  <node pkg="grasplan" type="insert.py" name="insert_object_node" output="screen" ns="$(arg namespace)" required="true">
    <param name="global_reference_frame" type="string" value="$(arg map_frame)" />
    <param name="place_pose_selector_activate_srv_name" type="string" value="$(arg ps)/place_pose_selector_node/pose_selector_activate" />
    <param name="place_pose_selector_clear_srv_name" type="string" value="$(arg ps)/place_pose_selector_node/pose_selector_clear" />
    <param name="pick_pose_selector_activate_srv_name" type="string" value="$(arg ps)/pick_pose_selector_node/pose_selector_activate" />
    <param name="pick_pose_selector_class_query_srv_name" type="string" value="$(arg ps)/pick_pose_selector_node/pose_selector_class_query" />
    <param name="pick_pose_selector_get_all_poses_srv_name" type="string" value="$(arg ps)/pick_pose_selector_node/pose_selector_get_all" />
    <rosparam file="$(find mobipick_pick_n_place)/config/grasplan/insert_params.yaml" command="load" />
    <param name="place_same_orientation_as_picked" value="$(arg place_same_orientation_as_picked)" />
    <param name="insert_orientation" type="str" value="$(arg insert_orientation)" />
    <param name="use_mtc" type="bool" value="$(arg use_mtc)" />
    <param name="mtc_cable_plan_check" type="bool" value="$(arg mtc_cable_plan_check)" />
    <param name="mtc_cable_replay_live_state" type="bool" value="$(arg mtc_cable_replay_live_state)" />
    <param name="insert_cable_gate" type="bool" value="$(arg insert_cable_gate)" />
    <param name="cable_detour_mode" type="string" value="$(arg cable_detour_mode)" />
  </node>

</launch>
